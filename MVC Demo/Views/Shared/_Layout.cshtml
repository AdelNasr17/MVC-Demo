<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" integrity="sha512-jnSuA4Ss2PkkikSOLtYs8BlYIeeIK1h99ty4YfvRPAlzr377vr3CXDb7sb7eEEBYjDtcYj+AjBH3FLv5uSJuXg==" crossorigin="anonymous" referrerpolicy="no-referrer" /> *@
</head>
<body>

    @* Start Header  *@

    <header>
        <center>
            <nav class="mt-5">
                @* 1.Html Tags | Static html *@
                <a href="/Home/Index" class="btn btn-primary m-2">Home</a>
                @* 2.Html Helper | Server-Side *@
                @* <a href="/Home/Privacy" class="btn btn-warning m-2">Privacy</a> *@

                @Html.ActionLink("Privacy", "Privacy", controllerName: "Home", htmlAttributes: new {@class="btn btn-warning m-2"},routeValues: null)

                @* 3.Tag Helpers *@
                   @* <a href="/Home/AboutUs" class="btn btn-success m-2">About us</a> *@
                <a asp-controller="Home" asp-action="AboutUs" asp-route-Id="10" class=" btn btn-success m-2">About Us</a>
                <a href="/Home/ContactUs" class="btn btn-secondary m-2">Contact Us</a>
                <a href="/Account/SignIn" class="btn btn-info m-2">Sign In</a>
                <a href="/Account/Register" class="btn btn-danger m-2">Register</a>
            </nav>
        </center>
    </header>


    @* End Header  *@
    <div>
        @RenderBody()
    </div>
    @* Start Footer  *@

    <footer>
        <center>
            <div class="mt-2">
                <p> CopyRights &copy; Route @DateTime.Now.Year </p>
            </div>
        </center>
    </footer>


    @* End Footer  *@


</body>
</html>
